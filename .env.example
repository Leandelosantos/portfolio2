# .env.example — buenas-practicas §3
# Copiar como .env.local y completar con valores reales
# NUNCA commitear .env.local

# Resend — server-only, usada en api/contact.js (sin prefijo VITE_, nunca se bundlea al cliente)
RESEND_API_KEY=re_xxxxxxxx

# WhatsApp — formato internacional con código de país
VITE_WHATSAPP_NUMBER=+5491168116492

# PostHog — client-side, público por diseño (igual que la public key de EmailJS)
VITE_POSTHOG_KEY=phc_xxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
