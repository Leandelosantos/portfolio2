    {"id":"reference_brand_aesthetic_lanes","label":"Reflex-Reject Aesthetic Lanes (Brand)","file_type":"rationale","source_file":".claude/skills/impeccable/reference/brand.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"By 2026 every Stripe/Notion-adjacent brand has converged on editorial-typographic (display serif italic + mono labels + ruled separators). The lane is flagged as saturated AI scaffolding to avoid by default unless the register specifically requires it."},
    {"id":"reference_bolder_register_distinction","label":"Bolder: Brand vs Product Distinction","file_type":"rationale","source_file":".claude/skills/impeccable/reference/bolder.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"In brand contexts bolder means distinctive (extreme scale, unexpected color, typographic risk); in product contexts bolder means stronger hierarchy and clarity, not theatrics, because theatrics undermine trust."},
    {"id":"reference_animate_register_distinction","label":"Animate: Brand vs Product Motion Register","file_type":"rationale","source_file":".claude/skills/impeccable/reference/animate.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Brand surfaces favor one well-rehearsed motion entrance over scattered micro-interactions, rejecting the saturated fade-and-rise-on-scroll default; product surfaces favor 150-250ms task-feedback motion with no page-load choreography since users are mid-task."}
